# ============================================================
# OpenRAM Project .gitignore
# ============================================================

# ---------- OpenRAM-generated outputs ----------
# Layout files (can be very large)
*.gds
*.gds.gz
*.mag
*.mag.gz

# SPICE netlists and simulation outputs
*.sp
*.spice
*.lvs.sp
*.pex.sp
*.sim
*.raw
*.wave

# Liberty, LEF, Verilog, and datasheet outputs
*.lib
*.lef
*.html
*.v
*.sv

# Verification reports
*.drc.results
*.lvs.results
*.drc.out
*.drc.err
*.ext.out
*.ext.err
*.ext.results
*.lvs.out
*.lvs.err

# Generated config / log / misc from a run
*_sram.py
*_sram.log
*_sram.lvs
*_sram.html
*_sram.lef
*_sram.lib
*_sram.v
*_sram.sp
*_sram.gds
*_sram.drc.*
*_sram.lvs.*
*_sram.ext.*
*_sram.pex.*

# OpenRAM run artifacts and temp
*.out
*.err
*.tmp
*.bak
run_*.sh
temp.gds
.magicrc
__openram_temp__/
openram_*_temp/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.python-version

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache
nosetests.xml
coverage.xml
*.cover

# Jupyter
.ipynb_checkpoints/

# ---------- Nix ----------
result
result-*
.direnv/
.envrc.local

# ---------- Editor / OS junk ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- Project-specific ----------
# Your scratch notes, saved terminal dumps, etc.
*.txt
!requirements.txt
!README.txt

# Passport drive mount artifacts
/media/nisitha/My_Passport/**/my_first_sram.*

# Local configs you don't want to commit
local_config.py
private_*.py